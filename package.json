{
  "name": "n-d-b",
  "version": "1.0.0",
  "description": "N-D-B Project repository",
  "author": "NedcloarBR",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N-D-B-Project/N-D-B"
  },
  "bugs": {
    "url": "https://github.com/N-D-B-Project/N-D-B/issues"
  },
  "homepage": "https://github.com/N-D-B-Project/N-D-B",
  "engines": {
    "node": "22.22.3"
  },
  "packageManager": "yarn@4.18.0",
  "type": "module",
  "imports": {
    "#src/*": {
      "types": "./src/*",
      "default": "./dist/src/*"
    }
  },
  "scripts": {
    "build": "nest build",
    "start": "NODE_ENV=production nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/src/main.js",
    "format": "yarn biome format --write ./",
    "lint": "yarn biome lint ./",
    "check": "yarn biome check --write ./",
    "postinstall": "husky install",
    "database:help": "yarn --cwd Database run help"
  },
  "dependencies": {
    "@ndb/database": "portal:./Database",
    "@necord/lavalink": "^2.0.0",
    "@necord/localization": "^5.0.0",
    "@necord/pagination": "^3.0.0",
    "@nestjs-redis/client": "^0.12.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.66.0",
    "@opentelemetry/core": "^2.2.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.207.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.207.0",
    "@opentelemetry/otlp-exporter-base": "^0.207.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.207.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "@sesamecare-oss/opentelemetry-node-metrics": "^1.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "discord-api-types": "^0.38.54",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.2",
    "lavalink-client": "^2.11.0",
    "moment": "^2.30.1",
    "necord": "^7.0.0",
    "parse-ms": "^4.0.0",
    "pg": "^8.13.3",
    "redis": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "topgg-autoposter": "^2.0.2",
    "typeorm": "^0.3.25",
    "typeorm-extension": "^3.6.3"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.3.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-angular": "^20.0.0",
    "@nedcloarbr/biome-config": "^2.0.2",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/node": "^24.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.3"
  }
}
